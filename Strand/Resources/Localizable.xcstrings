    },
    "Estimated mostly cleared. Nothing logged is likely still active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzungsweise größtenteils abgebaut. Nichts Erfasstes ist wahrscheinlich noch aktiv."
