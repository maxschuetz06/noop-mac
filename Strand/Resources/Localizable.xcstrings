            "state": "translated",
            "value": "Gewicht in Kilogramm"
          }
        }
      }
    },
    "Height in centimetres": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe in Zentimetern"
          }
        }
      }
    },
    "Waist (optional)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille (optional)"
          }
        }
      }
    },
    "Optional — adds your VO₂max estimate. The Fitness Age itself doesn't need it. Measure around your middle, at the navel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — ergänzt deine VO₂max-Schätzung. Das Fitnessalter selbst braucht sie nicht. Miss rund um die Körpermitte, auf Nabelhöhe."
          }
        }
      }
    },
    "Step calibration": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt-Kalibrierung"
          }
        }
      }
    },
    "Step calibration, %@ counter ticks per step": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritt-Kalibrierung, %@ Zählerschritte pro Schritt"
          }
        }
      }
    },
    "Counter ticks per step — leave at 1.0 unless your steps run high. On a WHOOP 5/MG they can run very high (10× or more), so this goes up to 30. Walk a known 1,000 steps and divide NOOP's count by the real count to get your value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählerschritte pro Schritt — lass es bei 1,0, außer deine Schritte sind zu hoch. Bei einem WHOOP 5/MG können sie sehr hoch ausfallen (10× oder mehr), deshalb geht der Wert bis 30. Geh genau 1.000 Schritte und teile NOOPs Zählung durch die echte Zahl, um deinen Wert zu erhalten."
          }
        }
      }
    },
    "Steps estimate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrittschätzung"
          }
        }
      }
    },
    "Steps estimate calibration. %@. Opens the calibration screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrierung der Schrittschätzung. %@. Öffnet den Kalibrierungsbildschirm."
          }
        }
      }
    },
    "For a WHOOP 4.0, which sends no step count: NOOP estimates steps from motion, calibrated to your phone. Tap to see how close it is and adjust it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein WHOOP 4.0, das keine Schrittzahl sendet: NOOP schätzt Schritte aus der Bewegung, kalibriert an deinem Telefon. Tippe, um zu sehen, wie nah sie liegt, und passe sie an."
          }
        }
      }
    },
    "Auto · %@ confidence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch · %@ Zuverlässigkeit"
          }
        }
      }
    },
    "Not calibrated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht kalibriert"
          }
        }
      }
    },
    "Weight in pounds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht in Pfund"
          }
        }
      }
    },
    "Weight, %lld pounds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, %lld Pfund"
          }
        }
      }
    },
    "Height in inches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe in Zoll"
          }
        }
      }
    },
    "Height, %lld feet %lld inches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe, %lld Fuß %lld Zoll"
          }
        }
      }
    },
    "Waist in centimetres": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille in Zentimetern"
          }
        }
      }
    },
    "Waist, %lld centimetres": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille, %lld Zentimeter"
          }
        }
      }
    },
    "Waist not set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille nicht festgelegt"
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht festgelegt"
          }
        }
      }
    },
    "Waist in inches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille in Zoll"
          }
        }
      }
    },
    "Waist, %lld inches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille, %lld Zoll"
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einheiten"
          }
        }
      }
    },
    "Choose how distances, weights, heights, temperatures and Effort are shown. Your data is always stored the same way — this only changes the display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie Distanzen, Gewichte, Größen, Temperaturen und Belastung angezeigt werden. Deine Daten werden immer gleich gespeichert — das ändert nur die Anzeige."
          }
        }
      }
    },
    "Measurement system": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maßsystem"
          }
        }
      }
    },
    "Imperial": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Imperial"
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatur"
          }
        }
      }
    },
    "Match": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie System"
          }
        }
      }
    },
    "Temperature unit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatureinheit"
          }
        }
      }
    },
    "Effort scale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastungsskala"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild"
          }
        }
      }
    },
    "Choose Light, Dark, or follow your system. Dark is the signature near-black; Light keeps the same clean look on a bright canvas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Hell, Dunkel oder folge deinem System. Dunkel ist das typische Fast-Schwarz; Hell behält denselben klaren Look auf hellem Grund."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        }
      }
    },
    "Chart colours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagrammfarben"
          }
        }
      }
    },
    "Default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard"
          }
        }
      }
    },
    "Grab this when you report a bug — it tells me what the app saw. (The full live log is also on the Live screen.)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir das, wenn du einen Fehler meldest — es zeigt mir, was die App gesehen hat. (Das vollständige Live-Protokoll gibt es auch auf dem Live-Bildschirm.)"
          }
        }
      }
    },
    "Continuous HRV capture": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontinuierliche HRV-Erfassung"
          }
        }
      }
    },
    "Keeps the detailed beat-to-beat heart-rate stream running all day and night, not just while a live screen is open, so NOOP captures much more for overnight HRV, recovery and sleep. Uses more battery — your strap streams heart rate continuously while connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den detaillierten Schlag-zu-Schlag-Herzfrequenzstream Tag und Nacht aktiv, nicht nur bei geöffnetem Live-Bildschirm, damit NOOP deutlich mehr für nächtliche HRV, Erholung und Schlaf erfasst. Verbraucht mehr Akku — dein Strap streamt die Herzfrequenz durchgehend, solange er verbunden ist."
          }
        }
      }
    },
    "Strap name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strap-Name"
          }
        }
      }
    },
    "Current: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell: %@"
          }
        }
      }
    },
    "New strap name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Strap-Name"
          }
        }
      }
    },
    "Changes the Bluetooth name your WHOOP 4.0 advertises — what you see when pairing. The strap reboots to apply, so the new name appears the next time it connects. WHOOP 4.0 only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert den Bluetooth-Namen, den dein WHOOP 4.0 anzeigt — den du beim Koppeln siehst. Der Strap startet zum Übernehmen neu, daher erscheint der neue Name bei der nächsten Verbindung. Nur WHOOP 4.0."
          }
        }
      }
    },
    "Your strap is paired and sending data. Open Live for a real-time heart rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Strap ist gekoppelt und sendet Daten. Öffne Live für die Herzfrequenz in Echtzeit."
          }
        }
      }
    },
    "Connected. Finishing the secure pairing handshake…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Die sichere Kopplung wird abgeschlossen…"
          }
        }
      }
    },
    "Previously paired but not currently connected. Re-scan to reconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früher gekoppelt, aber gerade nicht verbunden. Scanne erneut, um dich wieder zu verbinden."
          }
        }
      }
    },
    "No strap connected. Put your WHOOP nearby and tap Re-scan to pair.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Strap verbunden. Leg dein WHOOP in die Nähe und tippe auf Erneut scannen, um es zu koppeln."
          }
        }
      }
    },
    "Your Charge score learns a personal baseline from your heart-rate variability, resting heart rate and more over time. If a bad first week set it off, you can re-learn it from tonight. Your history stays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Charge-Wert lernt mit der Zeit eine persönliche Basislinie aus deiner Herzfrequenzvariabilität, deiner Ruheherzfrequenz und mehr. Wenn eine schlechte erste Woche sie verfälscht hat, kannst du sie ab heute Nacht neu lernen lassen. Dein Verlauf bleibt erhalten."
          }
        }
      }
    },
    "Recalibrate Charge baseline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge-Basislinie neu kalibrieren"
          }
        }
      }
    },
    "Restarts the roughly 4-night build-up for Charge and your HRV baseline from tonight. Use it if a bad first week set your baseline off. Your history stays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet den etwa 4-nächtigen Aufbau für Charge und deine HRV-Basislinie ab heute Nacht neu. Nutze es, wenn eine schlechte erste Woche deine Basislinie verfälscht hat. Dein Verlauf bleibt erhalten."
          }
        }
      }
    },
    "Charge baseline recalibrating": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge-Basislinie wird neu kalibriert"
          }
        }
      }
    },
    "NOOP will re-learn your baseline from tonight's data onward. Your history is kept, and it takes a few nights to settle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP lernt deine Basislinie ab den Daten von heute Nacht neu. Dein Verlauf bleibt erhalten, und es dauert ein paar Nächte, bis sie sich einpendelt."
          }
        }
      }
    },
    "Features": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen"
          }
        }
      }
    },
    "Optional trackers, off by default. Turn them on to add their cards. Everything stays on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Tracker, standardmäßig aus. Schalte sie ein, um ihre Karten hinzuzufügen. Alles bleibt auf %@."
          }
        }
      }
    },
    "Hydration tracking": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinkprotokoll"
          }
        }
      }
    },
    "Adds a water-log card to your dashboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt deinem Dashboard eine Trinkprotokoll-Karte hinzu"
          }
        }
      }
    },
    "Adds a simple fluid log with a daily goal that adjusts to your effort. Tap to add a sip, cup or bottle and watch a progress ring fill. On %@ only — nothing is synced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt ein einfaches Trinkprotokoll mit einem Tagesziel hinzu, das sich an deine Belastung anpasst. Tippe, um einen Schluck, eine Tasse oder eine Flasche hinzuzufügen, und sieh zu, wie sich ein Fortschrittsring füllt. Nur auf %@ — nichts wird synchronisiert."
          }
        }
      }
    },
    "Auto-detect workouts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts automatisch erkennen"
          }
        }
      }
    },
    "Offers to save a workout when it spots sustained elevated heart rate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet an, ein Workout zu speichern, wenn eine anhaltend erhöhte Herzfrequenz erkannt wird"
          }
        }
      }
    },
    "After a sync, NOOP looks over your recent heart rate for a sustained, raised stretch that looks like exercise and offers to save it. It only ever suggests — nothing is saved until you tap Save, and you can dismiss any suggestion. Deliberately conservative, so the odd workout may be missed. On %@ only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Synchronisierung sucht NOOP in deiner letzten Herzfrequenz nach einer anhaltend erhöhten Phase, die nach Training aussieht, und bietet an, sie zu speichern. Es schlägt nur vor — nichts wird gespeichert, bis du auf Speichern tippst, und du kannst jeden Vorschlag verwerfen. Bewusst zurückhaltend, daher kann gelegentlich ein Workout übersehen werden. Nur auf %@."
          }
        }
      }
    },
    "Experimental · Sleep staging": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell · Schlafphasen"
          }
        }
      }
    },
    "How NOOP splits a night into light / deep / REM. This is a separate, opt-in recipe — your default staging is unchanged unless you turn it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie NOOP eine Nacht in Leicht / Tief / REM aufteilt. Das ist ein separates, optionales Verfahren — deine Standard-Phaseneinteilung bleibt unverändert, solange du es nicht einschaltest."
          }
        }
      }
    },
    "Experimental sleep staging (V2)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentelle Schlafphasen (V2)"
          }
        }
      }
    },
    "A transparent cardiorespiratory recipe that recovers deep and REM better than the default staging. Opt-in and experimental — it only changes how already-detected nights are split into stages (detection and scores are unchanged), and the default staging stays in place if you leave this off. Takes effect on the next nights staged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein transparentes kardiorespiratorisches Verfahren, das Tief- und REM-Schlaf besser erkennt als die Standard-Phaseneinteilung. Optional und experimentell — es ändert nur, wie bereits erkannte Nächte in Phasen aufgeteilt werden (Erkennung und Werte bleiben unverändert), und die Standard-Phaseneinteilung bleibt bestehen, wenn du es ausgeschaltet lässt. Wirkt ab den nächsten eingeteilten Nächten."
          }
        }
      }
    },
    "Unlock WHOOP 5/MG deep data (R22)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe Daten von WHOOP 5/MG freischalten (R22)"
          }
        }
      }
    },
    "Send enable sequence to strap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierungssequenz an den Strap senden"
          }
        }
      }
    },
    "Strap accepted all 15 R22 flags": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strap hat alle 15 R22-Flags akzeptiert"
          }
        }
      }
    },
    "Strap accepted %lld/15 R22 flags…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strap hat %lld/15 R22-Flags akzeptiert…"
          }
        }
      }
    },
    "Flags accepted, but the enable sequence doesn't start a separate live stream — the deep records arrive as part of the normal history sync (#494).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags akzeptiert, aber die Aktivierungssequenz startet keinen separaten Live-Stream — die tiefen Datensätze kommen als Teil der normalen Verlaufs-Synchronisierung (#494)."
          }
        }
      }
    },
    "Broadcast heart rate (Garmin/ANT)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herzfrequenz senden (Garmin/ANT)"
          }
        }
      }
    },
    "Broadcast HR is ON. Your strap is advertising its heart rate continuously, which keeps its radio hot and drains the battery faster. Turn it off when you're not using it with another device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HF-Senden ist AN. Dein Strap sendet seine Herzfrequenz durchgehend, was das Funkmodul aktiv hält und den Akku schneller leert. Schalte es aus, wenn du es nicht mit einem anderen Gerät nutzt."
          }
        }
      }
    },
    "Export raw + log": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohdaten + Protokoll exportieren"
          }
        }
      }
    },
    "Saves the raw capture and the strap log together as a matched pair — attach both to a protocol-mapping issue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die Rohaufnahme und das Strap-Protokoll zusammen als passendes Paar — häng beides an ein Protocol-Mapping-Issue an."
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose"
          }
        }
      }
    },
    "A read-only export of the decoded sensor streams NOOP already stores. Works on any strap — nothing is written to your device, and nothing is uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schreibgeschützter Export der dekodierten Sensorstreams, die NOOP bereits speichert. Funktioniert mit jedem Strap — nichts wird auf dein Gerät geschrieben und nichts hochgeladen."
          }
        }
      }
    },
    "Exporting…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere…"
          }
        }
      }
    },
    "Export raw sensor data (CSV)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohe Sensordaten exportieren (CSV)"
          }
        }
      }
    },
    "Dumps the last 24 hours of decoded per-sample sensor streams (heart rate, R-R, motion, steps, SpO₂, skin temperature, respiration, events) to a single CSV — all on %@, nothing uploaded. Share it to help prototype and test sleep, activity and strength algorithms.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert die letzten 24 Stunden der dekodierten Sensorstreams pro Messwert (Herzfrequenz, R-R, Bewegung, Schritte, SpO₂, Hauttemperatur, Atmung, Ereignisse) in eine einzelne CSV — alles auf %@, nichts wird hochgeladen. Teile sie, um Schlaf-, Aktivitäts- und Kraftalgorithmen zu entwickeln und zu testen."
          }
        }
      }
    },
    "Daily auto-export of the strap log": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliches automatisches Exportieren des Strap-Protokolls"
          }
        }
      }
    },
    "Time of day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit"
          }
        }
      }
    },
    "Daily auto-export time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit des täglichen automatischen Exports"
          }
        }
      }
    },
    "Run now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ausführen"
          }
        }
      }
    },
    "Writes a timestamped copy of your strap log to your Documents folder, once a day — handy for a bug report without remembering to grab it. On Mac it runs while NOOP is open (and catches up on launch if the time passed while it was closed). Everything stays on %@; nothing is uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt einmal täglich eine Kopie deines Strap-Protokolls mit Zeitstempel in deinen Ordner „Dokumente“ — praktisch für einen Fehlerbericht, ohne daran denken zu müssen. Auf dem Mac läuft es, solange NOOP geöffnet ist (und holt es beim Start nach, wenn die Zeit verstrichen ist, während es geschlossen war). Alles bleibt auf %@; nichts wird hochgeladen."
          }
        }
      }
    },
    "Strap log exported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strap-Protokoll exportiert"
          }
        }
      }
    },
    "Saved %@ to NOOP's folder in the Files app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in NOOPs Ordner in der Dateien-App gespeichert."
          }
        }
      }
    },
    "Saved %@ to your Documents folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in deinem Ordner „Dokumente“ gespeichert."
          }
        }
      }
    },
    "Export failed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export fehlgeschlagen"
          }
        }
      }
    },
    "Couldn't write the strap log right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Strap-Protokoll konnte gerade nicht geschrieben werden."
          }
        }
      }
    },
    "Nothing to export": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu exportieren"
          }
        }
      }
    },
    "No raw capture has been recorded yet this session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Sitzung wurde noch keine Rohaufnahme erfasst."
          }
        }
      }
    },
    "Move all your NOOP data to another machine. Export saves everything — history, sleeps, workouts, settings — to a single file you can copy across; import replaces %@'s data with a backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertrage alle deine NOOP-Daten auf ein anderes Gerät. Der Export speichert alles — Verlauf, Schlaf, Workouts, Einstellungen — in einer einzelnen Datei, die du kopieren kannst; der Import ersetzt die Daten auf %@ durch ein Backup."
          }
        }
      }
    },
    "Export CSV…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV exportieren…"
          }
        }
      }
    },
    "Importing overwrites everything currently on %@. Your old data is kept in a side file just in case. NOOP needs a relaunch for an import to take effect. Export CSV writes a WHOOP-format zip of your days, sleeps, workouts and journal that re-imports into NOOP on Mac, iPhone, or Android — on-device computed rows are marked APPROXIMATE in its Source column; the full backup stays the lossless restore path.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import überschreibt alles, was sich aktuell auf %@ befindet. Deine alten Daten werden sicherheitshalber in einer separaten Datei aufbewahrt. NOOP muss neu gestartet werden, damit ein Import wirkt. „CSV exportieren“ schreibt eine ZIP-Datei im WHOOP-Format mit deinen Tagen, Schlafphasen, Workouts und deinem Journal, die sich in NOOP auf Mac, iPhone oder Android wieder importieren lässt — auf dem Gerät berechnete Zeilen sind in der Spalte Source als APPROXIMATE markiert; das vollständige Backup bleibt der verlustfreie Weg zur Wiederherstellung."
          }
        }
      }
    },
    "CSV exported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV exportiert"
          }
        }
      }
    },
    "Saved to %@. The zip re-imports into NOOP (Data Sources → WHOOP Export) on any Mac, iPhone, or Android device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert unter %@. Die ZIP-Datei lässt sich in NOOP (Datenquellen → WHOOP-Export) auf jedem Mac, iPhone oder Android-Gerät wieder importieren."
          }
        }
      }
    },
    "Export problem": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportproblem"
          }
        }
      }
    },
    "Backup exported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup exportiert"
          }
        }
      }
    },
    "Saved to %@. Copy this file to your other %@ and use Import there to restore everything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert unter %@. Kopiere diese Datei auf dein anderes %@ und nutze dort Import, um alles wiederherzustellen."
          }
        }
      }
    },
    "Backup imported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup importiert"
          }
        }
      }
    },
    "Your data has been restored. Quit and reopen NOOP for it to take effect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten wurden wiederhergestellt. Beende NOOP und öffne es erneut, damit sie wirksam werden."
          }
        }
      }
    },
    "Backup problem": {
      "localizations": {
