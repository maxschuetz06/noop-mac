    "Pairs directly with your strap over Bluetooth — no WHOOP app, no cloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelt sich per Bluetooth direkt mit deinem Strap — keine WHOOP-App, keine Cloud."
          }
        }
      }
