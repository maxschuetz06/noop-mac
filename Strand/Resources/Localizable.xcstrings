    },
    "Your last %lld hours have stayed in the high band. A few minutes of paced breathing can help downshift your nervous system.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzten %lld Stunden lagen im hohen Bereich. Ein paar Minuten ruhiges Atmen können dein Nervensystem herunterfahren."
          }
        }
      }
    },
    "Start a Breathe session": {
