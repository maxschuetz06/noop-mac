    "How NOOP works": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert NOOP"
          }
        }
      }
    },
    "Sleep sorting, scores, recording, and where your numbers come from.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafeinteilung, Werte, Aufzeichnung und woher deine Zahlen kommen."
          }
        }
      }
    },
    "Charge, Effort and Rest — and how they differ from WHOOP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge, Belastung und Ruhe — und wie sie sich von WHOOP unterscheiden."
          }
        }
      }
