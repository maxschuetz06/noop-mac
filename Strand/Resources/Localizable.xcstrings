    "Project home & source": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektseite & Quellcode"
          }
        }
      }
    },
    "GitHub — code, releases and issues.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub — Code, Releases und Issues."
          }
        }
      }
    },
    "Project home and source code at noop dot fans": {
      "localizations": {
        "de": {
