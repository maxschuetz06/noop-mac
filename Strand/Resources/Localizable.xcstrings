    "Download": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herunterladen"
          }
        }
      }
    },
    "Checks the project's home (GitHub) for the latest version when you tap — nothing else is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht beim Tippen auf der Projektseite (GitHub) nach der neuesten Version — sonst wird nichts gesendet."
