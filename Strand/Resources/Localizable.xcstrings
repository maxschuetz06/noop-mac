    "Storage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher"
          }
        }
      }
    },
    "Where NOOP's on-device space is going — and a one-tap clean-up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür NOOP den Speicher auf dem Gerät nutzt — und eine Bereinigung mit einem Tippen."
