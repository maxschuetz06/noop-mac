    },
    "This Mac app is an unofficial fork of NOOP by NoopApp. It is not maintained or endorsed by NoopApp.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mac-App ist ein inoffizieller Fork von NOOP von NoopApp. Sie wird von NoopApp weder gepflegt noch unterstützt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
